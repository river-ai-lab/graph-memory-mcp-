# MCP Graph Memory Configuration
#
# Copy this file to `.env` in the root directory and adjust values.
# The server will automatically load this file on startup.

# =============================================================================
# Core Server Settings
# =============================================================================

# When false, background jobs do not start. The HTTP server still starts.
MCP_SERVER_ENABLED=true

# MCP clients see MCP_SERVER_DESCRIPTION when it is set, otherwise MCP_SERVER_NAME.
MCP_SERVER_NAME=memory
MCP_SERVER_DESCRIPTION="Memory MCP server for knowledge graph (ArcadeDB)"

# Default owner_id when an MCP tool call omits the argument (agents should still pass explicitly).
DEFAULT_OWNER_ID=default

# Who chooses the owner on an MCP HTTP call.
# client (default): the tool argument. Trusted local or company deploy.
# header: ignore the tool argument. Bind 127.0.0.1 and let the gateway set
# X-Owner-Id and Authorization: Bearer $ADMIN_TOKEN.
# Without ADMIN_TOKEN the process only starts on 127.0.0.1, ::1, or localhost.
# token: Bearer API key. owner_id must be one of the key's projects;
# omit it to use the first project. Author is the key's name.
OWNER_SCOPE=client

# Hash file used when OWNER_SCOPE=token. The raw key is never written here.
# Each entry is {id, hash, name, projects, created_at}.
# API_KEYS_FILE=./keys.json

# /admin token. client and header: /admin is open when this is empty.
# header: /mcp checks it when set. /internal/graph-size always requires it.
# A non-loopback header bind without this token refuses to start.
# token mode: the server refuses to start when this is empty, and /admin always requires it.
# ADMIN_TOKEN=

# Header mode only. 1 logs a warning and starts on a non-loopback address
# without ADMIN_TOKEN. Anyone who can reach the port can set X-Owner-Id.
# Prefer ADMIN_TOKEN or 127.0.0.1. client and token ignore this.
# ALLOW_INSECURE_HEADER=1

# Client mode only. /mcp has no authentication in client mode, so a
# non-loopback bind (0.0.0.0, ::, LAN IP) refuses to start. 1 logs a warning
# and starts anyway. Prefer 127.0.0.1 or OWNER_SCOPE=token.
# ALLOW_INSECURE_CLIENT=1

# Also expose test_connection, ensure_vector_indexes, export_owner, and
# import_owner as MCP tools. Default false: those stay on HTTP /admin.
MCP_EXPOSE_ADMIN_TOOLS=false

# =============================================================================
# Database Connection
# =============================================================================

# arcadedb (default) or falkordb
GRAPH_BACKEND=arcadedb

# ArcadeDB server (default backend)
# Each owner_id is its own database: {ARCADE_DATABASE}_{owner_id}.
ARCADE_HOST=localhost
ARCADE_PORT=2480
ARCADE_USER=root
ARCADE_PASSWORD=playwithdata
ARCADE_DATABASE=memory

# FalkorDB server (set GRAPH_BACKEND=falkordb to use)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=memory
FALKORDB_PASSWORD=falkordb123

# =============================================================================
# Embeddings
# =============================================================================

# onnx (default) runs fp32 onnx/model.onnx from the Hugging Face repo with
# ONNX Runtime. torch uses sentence-transformers and needs the optional extra:
#   uv sync --extra torch
# Quantized ONNX files are not used.
EMBEDDING_BACKEND=onnx

# Same model id for both backends.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Model prompt prefixes. e5-family models are trained with "query: " / "passage: "
# — set both for e5, leave empty for models without prompt conventions.
# Code default is empty. The values below are for the default e5 model.
# WARNING: changing prefixes (like changing the model) requires re-embedding
# the existing corpus — see README "Vector Indexes".
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# Create Fact + Entity vector indexes at MCP server startup (optional;
# indexes are also created automatically on first search/auto_link if missing)
AUTO_CREATE_INDEXES=false

# =============================================================================
# Search & Graph Defaults
# =============================================================================

DEFAULT_SEARCH_LIMIT=10
# Hard cap for `limit` on search-like tools
MAX_SEARCH_LIMIT=100
SEMANTIC_SIMILARITY_THRESHOLD=0.55
# pre_filter | post_filter — server default when search_type omitted on MCP calls
SEARCH_TYPE=pre_filter
# search tool default mode: embedding | bm25 | fuzzy | exact | hybrid
SEARCH_MODE=embedding
# Optional ONNX cross-encoder reranker (off by default; English model, ~90 MB download)
SEARCH_RERANKER=false
SEARCH_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
SEARCH_RERANK_TOP_K=30
# post_filter only: global ANN candidate pool (queryNodes k)
POST_FILTER_ANN_K_MIN=100
POST_FILTER_ANN_K_MAX=2000

# Auto-linking (create_node / upsert_node auto_link=true only; default is false)
AUTO_LINKING_SEMANTIC_THRESHOLD=0.75
NEIGHBOURS_SEARCH_THRESHOLD=0.8

# Subgraph exploration limits
SUBGRAPH_DEFAULT_DEPTH=1
SUBGRAPH_MAX_DEPTH=3
SUBGRAPH_DEFAULT_MAX_NODES=20
SUBGRAPH_MAX_NODES_LIMIT=50
RECALL_CONTEXT_DEFAULT_DEPTH=2
RECALL_CONTEXT_SEED_LIMIT=5
RECALL_CONTEXT_HOP_DECAY=0.7
# Compact recall (search / recall_context when compact=true)
COMPACT_RECALL_TOKEN_BUDGET=800
COMPACT_SNIPPET_CHARS=180
# get_brief anchor fact (upsert_node source.ref). Empty graph → about is null.
ABOUT_SOURCE_REF=about
# Hybrid search rank (cosine weight = 1 - lexical - recency)
SEARCH_LEXICAL_WEIGHT=0.35
SEARCH_RECENCY_WEIGHT=0.10
SEARCH_RECENCY_HALF_LIFE_DAYS=14
# Time-aware recall: 0 disables the factor
RECALL_RECENCY_WEIGHT=0.2
RECALL_RECENCY_HALF_LIFE_DAYS=30.0
RECALL_USAGE_WEIGHT=0.1

# Duplicate detection
# Soft list on a successful write (possible_duplicates)
DUPLICATE_SIMILARITY_THRESHOLD=0.85
# create_node refuses a Fact at or above this similarity (memory_duplicate)
CREATE_DUPLICATE_BLOCK_THRESHOLD=0.92
# Warn on long text; the write is not blocked
LONG_TEXT_WARN_CHARS=600
DUPLICATE_MAX_GROUP_SIZE=10
DUPLICATE_TOP_K=100

# Summarization
SUMMARY_SIMILARITY_THRESHOLD=0.7

# Relation type allowlist (create_relation, create_node links, create_triplet)
# off | warn | enforce
RELATION_POLICY_ENFORCE=warn
RELATION_ALLOWED_TYPES=RELATED_TO,MENTIONS,SUMMARIZES,FOLLOWS_FROM,CONTRADICTS,EXTRACTED_FROM,SIMILAR_TO,NEXT_STEP,EXPOSES,CROSS_REF,RUNS_ON,USES,SERVED_BY

# =============================================================================
# Maintenance & Logs
# =============================================================================

CLEANUP_DAYS_THRESHOLD=90
LOG_TTL_DAYS=10
LOG_CLEANUP_FREQUENCY=10
# get_brief: facts not recalled for N days are reported as stale
STALE_FACTS_DAYS=30

# =============================================================================
# Background Jobs (APScheduler)
# =============================================================================

# Master switch. Archive and dedup both run. Set a job flag below to false to turn that one off.
JOBS_ENABLED=false

# Empty = every owner. One id, or a comma list, runs jobs only for those tenants.
JOBS_OWNER_IDS=
# true ignores JOBS_OWNER_IDS and runs for every owner.
JOBS_PROCESS_ALL_OWNERS=false

# Job locking (in seconds)
JOBS_LOCK_TTL_SECONDS=600

# Job: Deduplicate Facts (on when JOBS_ENABLED=true)
JOB_DEDUPLICATE_ENABLED=true
JOB_DEDUPLICATE_CRON="0 * * * *"  # Run hourly
JOB_DEDUPLICATE_HOURS_THRESHOLD=24
JOB_DEDUPLICATE_SIMILARITY_THRESHOLD=0.95

# Job: Archive Old Facts (on when JOBS_ENABLED=true)
JOB_ARCHIVE_ENABLED=true
JOB_ARCHIVE_CRON="0 3 * * 0"  # Run weekly (Sunday 3am)
# Also archive active facts not recalled for STALE_FACTS_DAYS. Default false.
# A fact that still has an active neighbor is skipped.
JOB_ARCHIVE_STALE_ENABLED=false

# Job Retry Policy
JOB_RETRY_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_BASE=2.0
JOB_RETRY_BACKOFF_MAX=30.0

# =============================================================================
# Versioning
# =============================================================================

# Snapshot nodes before update when the caller omits `versioning`
# (guaranteed history / as_of reads without relying on agent discipline)
VERSIONING_DEFAULT=false

# =============================================================================
# Validation Limits
# =============================================================================

MAX_TEXT_LENGTH=10000
MAX_METADATA_SIZE=100000
MIN_TTL_DAYS=0.0
MAX_TTL_DAYS=3650.0

# =============================================================================
# Caching
# =============================================================================

CACHE_EMBEDDINGS_ENABLED=true
CACHE_EMBEDDINGS_MAXSIZE=1000

CACHE_SEARCH_ENABLED=true
CACHE_SEARCH_MAXSIZE=100
CACHE_SEARCH_TTL=60
